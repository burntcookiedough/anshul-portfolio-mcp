{
  "name": "anshul-portfolio-mcp",
  "version": "1.0.3",
  "mcpName": "io.github.burntcookiedough/anshul-portfolio-mcp",
  "description": "Anshul Panigrahi's portfolio as an MCP server: profile, projects, patents and contact, for any MCP client.",
  "type": "module",
  "bin": {
    "anshul-portfolio-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "data/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/server.test.mjs",
    "sync-data": "node -e \"for (const f of ['resume.json','profile.md']) fetch('https://burntcookiedough.github.io/'+f).then(r=>r.text()).then(t=>require('fs').writeFileSync('data/'+f,t))\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "portfolio",
    "resume"
  ],
  "author": "Anshul Panigrahi <anshulpanigrahi3678@gmail.com> (https://burntcookiedough.github.io/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burntcookiedough/anshul-portfolio-mcp.git"
  },
  "homepage": "https://github.com/burntcookiedough/anshul-portfolio-mcp#readme"
}
